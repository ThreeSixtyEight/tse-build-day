---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import SoundToggle from '../components/SoundToggle.astro';
import { site } from '../site.config';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.siteDescription } = Astro.props;
const pageTitle = title ? `${title} | ${site.siteName}` : site.siteName;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-Y18TP3N3Z0"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-Y18TP3N3Z0');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
    <!-- Adobe Fonts kit: Gunter for the hero title. -->
    <link rel="stylesheet" href="https://use.typekit.net/fiq4wtl.css" />
    <!-- Adobe Fonts kit: Arnika for quotes and eyebrows. -->
    <link rel="stylesheet" href="https://use.typekit.net/rvf8bga.css" />
    <!-- Outfit Light (Google Fonts): paragraph copy in content blocks, from the Build Day Figma. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300&display=swap" />
    <!-- Excon (Fontshare): buttons and body text from the Build Day Figma. -->
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=excon@400&display=swap" />
    <!-- Marker.io -->
    <script>
      window.markerConfig = {
        project: '6ae275b5109dc4854338777d',
        source: 'snippet'
      };
      !function(e,r,a){if(!e.__Marker){e.__Marker={};var t=[],n={__cs:t};["show","hide","isVisible","capture","cancelCapture","unload","reload","isExtensionInstalled","setReporter","clearReporter","setCustomData","on","off"].forEach(function(e){n[e]=function(){var r=Array.prototype.slice.call(arguments);r.unshift(e),t.push(r)}}),e.Marker=n;var s=r.createElement("script");s.async=1,s.src="https://edge.marker.io/latest/shim.js";var i=r.getElementsByTagName("script")[0];i.parentNode.insertBefore(s,i)}}(window,document);
    </script>
  </head>
  <body>
    <main id="main">
      <slot />
    </main>
    <Footer />
    <SoundToggle />
    <script>
      // Scroll reveal: headings, eyebrows, paragraphs and pictures that aren't full width fade in and rise once, as they
      // scroll into view (styles in global.css). Several arriving together follow one another a beat apart.
      // Left alone, since they animate in their own way or fill the screen: the hero, the pull quotes (their words
      // reveal one at a time), the piano, the music staff and the paintings behind the night openers.
      const TARGETS = [
        'h1, h2, h3, p',
        // Pictures go by their frame or box, so the picture doesn't slide inside it.
        '.opener__frame, .aside__frame, .aside__cutout, .aside__bleed',
        '.eol__inst img',
      ].join(', ');
      const SKIP = '.hero, .quote, #piano, .staff';

      const els = [...document.querySelectorAll<HTMLElement>(`main :is(${TARGETS}), footer p`)].filter(
        (el) => !el.closest(SKIP),
      );
      const io = new IntersectionObserver(
        (entries) => {
          entries
            .filter((entry) => entry.isIntersecting)
            .forEach((entry, i) => {
              const el = entry.target as HTMLElement;
              el.style.transitionDelay = `${i * 90}ms`;
              el.classList.add('is-in');
              io.unobserve(el);
            });
        },
        // Starts a little before the element's top clears the bottom of the screen.
        { rootMargin: '0px 0px -8% 0px' },
      );
      for (const el of els) {
        el.classList.add('reveal');
        io.observe(el);
      }
    </script>
  </body>
</html>
