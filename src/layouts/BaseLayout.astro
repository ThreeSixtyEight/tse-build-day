---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Cursor from '../components/Cursor.astro';
import EntryGate from '../components/EntryGate.astro';
import SoundToggle from '../components/SoundToggle.astro';
import { site } from '../site.config';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.siteDescription } = Astro.props;
const pageTitle = title ? `${title} | ${site.siteName}` : site.siteName;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
    <!-- Adobe Fonts kit: Gunter for the hero title. -->
    <link rel="stylesheet" href="https://use.typekit.net/fiq4wtl.css" />
  </head>
  <body>
    <EntryGate />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <SoundToggle />
    <Cursor />
  </body>
</html>
