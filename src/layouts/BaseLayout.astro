---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cursor from '../components/Cursor.astro';
import EntryGate from '../components/EntryGate.astro';
import SoundToggle from '../components/SoundToggle.astro';
import { site } from '../site.config';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.siteDescription } = Astro.props;
const pageTitle = title ? `${title} | ${site.siteName}` : site.siteName;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <EntryGate />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <SoundToggle />
    <Cursor />
  </body>
</html>
