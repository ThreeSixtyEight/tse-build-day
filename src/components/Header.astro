---
import { site } from '../site.config';
const links = [
  { href: '/instrument', label: 'Instruments' },
  { href: '/game', label: 'Game' },
];
const current = (href: string) => (Astro.url.pathname.startsWith(href) ? 'page' : undefined);
---

<header class="header">
  <div class="wrap header__inner">
    <a href="/#entry" class="logo">{site.siteName}</a>
    <nav class="header__nav" aria-label="Main">
      {links.map((l) => <a href={l.href} class="header__link" aria-current={current(l.href)}>{l.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .header { border-bottom: 1px solid var(--line); }
  .header__inner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 4rem; }
  .logo { font-weight: 700; text-decoration: none; }
  .header__nav { display: flex; gap: 1.5rem; }
  .header__link { text-decoration: none; }
  .header__link:hover, .header__link[aria-current='page'] { text-decoration: underline; }
</style>
