---
// Falling music notes, after Osmo Supply's "Falling 2D Objects (MatterJS)".
// Black notes drop into a square canvas pinned to the bottom of the footer and can be thrown around.
// They start falling the first time the footer scrolls into view.
import { site } from '../site.config';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="canvas-matter" aria-hidden="true">
    <div class="canvas-matter__before"></div>
    <div id="canvas-target" class="canvas-matter__target"></div>
  </div>

  <div class="footer__inner wrap">
    <div class="footer__meta">
      <div class="footer__col">
        <p>An unofficial fan site. Not affiliated with or endorsed by Jon Batiste.</p>
        <p>© {year}</p>
      </div>
      <div class="footer__col">
        <a href="/#transcript">[ Transcript ]</a>
        <a href="/#credits">[ Credits ]</a>
        <!-- Required by the samples' CC BY 3.0 license. -->
        <p class="footer__credit">
          Piano sound: <a href="https://archive.org/details/SalamanderGrandPianoV3">Salamander Grand Piano</a>,
          Alexander Holm, <a href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a>
        </p>
      </div>
      <div class="footer__col">
        <a href="/instrument">[ Instruments ]</a>
        <a href="/game">[ Game ]</a>
      </div>
      <div class="footer__col footer__col--right">
        <p>Made by</p>
        <a href="https://threesixtyeight.com">ThreeSixtyEight</a>
        <a href={site.officialSite}>[ Official site ]</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    height: 100svh;
    min-height: 32rem;
    background: #fff;
    color: #000;
  }

  /* Text sits over the canvas but lets drags through, except on the links. */
  .footer__inner {
    position: relative;
    z-index: 1;
    pointer-events: none;
    padding-top: clamp(2rem, 4vw, 3rem);
  }
  .footer a { pointer-events: auto; }

  .footer__meta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.875rem;
    line-height: 1.7;
  }
  .footer__col { display: flex; flex-direction: column; align-items: flex-start; }
  .footer__col--right { align-items: flex-end; text-align: right; }
  .footer__col p { margin: 0; color: #555; }
  .footer__col p + p { margin-top: 0.5rem; }
  .footer a { color: #000; text-decoration: none; white-space: nowrap; }
  .footer a:hover { text-decoration: underline; }
  .footer a:focus-visible { outline: 2px solid #000; outline-offset: 2px; }
  .footer__col .footer__credit { margin-top: 0.75rem; max-width: 22em; font-size: 0.75rem; line-height: 1.5; }
  .footer__credit a { white-space: normal; }

  .canvas-matter {
    width: 100%;
    position: absolute;
    bottom: 0;
    left: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .canvas-matter__before { padding-top: 100%; }
  .canvas-matter__target {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    overflow: hidden;
  }
  #canvas-target :global(canvas) {
    position: relative;
    top: -1px;
    left: -1px;
    pointer-events: all;
    max-width: calc(100% + 2px);
    max-height: calc(100% + 2px);
    min-width: calc(100% + 2px);
    min-height: calc(100% + 2px);
  }

  @media (max-width: 40em) {
    .footer__meta { grid-template-columns: 1fr 1fr; row-gap: 1.25rem; }
    .footer__col--right { align-items: flex-start; text-align: left; }
  }
</style>

<script>
  import Matter from 'matter-js';

  // Phosphor Icons (MIT), fill weight, recoloured black and sized 256 × 256.
  const NOTE_SVGS = ['music-note', 'music-notes', 'music-note-simple', 'music-notes-simple'].map((name) => `/footer/${name}.svg`);

  const target = document.querySelector<HTMLElement>('#canvas-target');
  if (target) {
    new IntersectionObserver((entries, observer) => {
      if (!entries[0].isIntersecting) return;
      observer.disconnect();
      initFalling2DMatterJS(target);
    }, { threshold: 0.25 }).observe(target.closest('footer')!);
  }

  function initFalling2DMatterJS(canvas: HTMLElement) {
    const canvasWidth = canvas.clientWidth + 2;
    const canvasHeight = canvas.clientHeight + 2;
    const canvasWallDepth = canvasWidth / 4;
    const noteAmount = 15; // Amount of objects added to the canvas
    const noteSize = canvasWidth / 7.5; // Size of objects
    const noteSizeTexture = 256; // Size of object texture in pixels
    const noteSizeScale = noteSize / noteSizeTexture;
    const noteRestitution = 0.75; // Bounciness
    const worldGravity = 2; // Gravity

    const { Engine, Render, Runner, Bodies, Composite, Mouse, MouseConstraint } = Matter;

    const engine = Engine.create();
    engine.world.gravity.y = worldGravity;

    const render = Render.create({
      element: canvas,
      engine: engine,
      options: {
        background: 'transparent',
        wireframes: false,
        width: canvasWidth,
        height: canvasHeight,
        pixelRatio: 2,
      },
    });

    const getRandomNumber = (min: number, max: number) => Math.random() * (max - min) + min;
    const min = noteSize / 2;
    const max = canvasWidth - noteSize / 2;

    let textureIndex = 0;
    function getNextTexture() {
      const texture = NOTE_SVGS[textureIndex];
      textureIndex = (textureIndex + 1) % NOTE_SVGS.length;
      return texture;
    }

    const noteCreate = () => {
      const note = Bodies.rectangle(getRandomNumber(min, max), noteSize, noteSize, noteSize, {
        chamfer: { radius: noteSize / 2 },
        restitution: noteRestitution,
        angle: getRandomNumber(-0.4, 0.4),
        render: {
          sprite: {
            texture: getNextTexture(),
            xScale: noteSizeScale,
            yScale: noteSizeScale,
          },
        },
      });
      Composite.add(engine.world, note);
    };

    // Walls around the canvas. The spec names the floor "boxTop" and the ceiling "boxBottom".
    const floor = Bodies.rectangle(canvasWidth / 2 + canvasWallDepth * 2, canvasHeight + canvasWallDepth, canvasWidth + canvasWallDepth * 4, canvasWallDepth * 2, { isStatic: true });
    const left = Bodies.rectangle(canvasWallDepth * -1, canvasHeight / 2, canvasWallDepth * 2, canvasHeight, { isStatic: true });
    const right = Bodies.rectangle(canvasWidth + canvasWallDepth, canvasHeight / 2, canvasWallDepth * 2, canvasHeight, { isStatic: true });
    const ceiling = Bodies.rectangle(canvasWidth / 2 + canvasWallDepth * 2, canvasWallDepth * -1, canvasWidth + canvasWallDepth * 4, canvasWallDepth * 2, { isStatic: true });
    Composite.add(engine.world, [floor, left, right, ceiling]);

    Render.run(render);
    Runner.run(Runner.create(), engine);

    function repeatedFunction(count: number, maxCount: number) {
      if (count < maxCount) {
        noteCreate();
        setTimeout(() => repeatedFunction(count + 1, maxCount), 100);
      }
    }
    repeatedFunction(0, noteAmount);

    const mouse = Mouse.create(render.canvas);
    const mouseConstraint = MouseConstraint.create(engine, {
      mouse: mouse,
      constraint: { stiffness: 0.2, render: { visible: false } },
    });
    Composite.add(engine.world, mouseConstraint);

    // Matter's mouse handlers aren't in its types, so reach them loosely.
    const m = mouseConstraint.mouse as any;

    // Fix: Allow native page scroll
    m.element.removeEventListener('mousewheel', m.mousewheel);
    m.element.removeEventListener('DOMMouseScroll', m.mousewheel);

    // Fix: Scroll on touch devices
    m.element.removeEventListener('touchstart', m.mousedown);
    m.element.removeEventListener('touchmove', m.mousemove);
    m.element.removeEventListener('touchend', m.mouseup);

    m.element.addEventListener('touchstart', m.mousedown, { passive: true });
    m.element.addEventListener('touchmove', (e: TouchEvent) => {
      if (mouseConstraint.body) m.mousemove(e);
    });
    m.element.addEventListener('touchend', (e: TouchEvent) => {
      if (mouseConstraint.body) m.mouseup(e);
    });
  }
</script>
