---
import { site } from '../site.config';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <p>© {year} {site.siteName}</p>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); color: var(--muted); padding-block: 2rem; margin-top: 4rem; }
  .footer p { margin: 0; }
</style>
