---
// A chapter's second panel: flat neutral background, a cutout figure on the left with text beside it and a
// prop behind it. As the page scrolls the prop drifts slower than the cutout, so the two separate in depth.
// A bleed cutout instead rolls in from the left each time its panel arrives, and comes to rest flush with the
// left edge of the screen; it never moves right of it, so no gap opens. Reduced motion: no drift or roll.
import Quote from './Quote.astro';

interface Props {
  id: string;
  number: number;
  heading: string;
  body: string;
  cutout: { src: string; alt: string; bleed?: boolean };
  prop?: { src: string; alt: string };
  quote?: { text: string; source: string; date: string; url?: string };
  caption?: string;
}

const { id, number, heading, body, cutout, prop, quote, caption } = Astro.props;
---

<section class="section flat" id={id} data-section={id}>
  <div class="flat__art" aria-hidden={cutout.alt ? undefined : 'true'}>
    {prop && <img class="flat__prop" src={prop.src} alt={prop.alt} data-drift="0.15" />}
    {
      cutout.bleed ? (
        <img class="flat__cutout flat__cutout--bleed" src={cutout.src} alt={cutout.alt} data-roll />
      ) : (
        <img class="flat__cutout" src={cutout.src} alt={cutout.alt} data-drift="0.04" />
      )
    }
  </div>
  <div class="flat__text">
    <p class="flat__num">{String(number).padStart(2, '0')}</p>
    <h2>{heading}</h2>
    {body.split(/\n\s*\n/).map((para) => <p>{para.trim()}</p>)}
    {quote && <Quote {...quote} />}
    {caption && <p class="caption">{caption}</p>}
  </div>
</section>

<style>
  .flat {
    --text: #1d1a17;
    --muted: rgb(29 26 23 / 0.7);
    --line: rgb(29 26 23 / 0.2);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    align-items: center;
    /* The page's full-screen panel rule is scoped to index.astro, so a flat panel sets its own height. */
    min-height: 100svh;
    padding-block: 3rem;
    overflow: hidden;
    color: var(--text);
    background: #efe7d8;
  }
  /* Wavy bottom edge from the storyboard. */
  .flat::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 28px;
    background: radial-gradient(circle at 20px -6px, transparent 22px, #d9cdb6 23px) 0 0 / 40px 28px repeat-x;
    pointer-events: none;
  }
  .flat__text { position: relative; z-index: 1; padding-inline: 1rem clamp(1.5rem, 6vw, 6rem); max-width: 38rem; }
  .flat__num { margin: 0; font-family: 'Melodrama', serif; font-weight: 700; letter-spacing: 0.2em; color: #b5832a; }
  .flat h2 { margin: 0.25rem 0 1rem; font-family: 'gunter', 'Melodrama', serif; font-weight: 400; font-size: clamp(2.25rem, 5vw, 4rem); line-height: 0.95; text-transform: uppercase; }
  .flat__art { position: relative; align-self: stretch; }
  .flat__prop, .flat__cutout { position: absolute; max-width: none; }
  .flat__prop { left: -30%; bottom: 12%; width: 115%; }
  .flat__cutout { left: 18%; bottom: 0; height: 82%; width: auto; }
  .flat__cutout--bleed { left: 0; bottom: 14%; width: 100%; height: auto; }

  @media (max-width: 760px) {
    .flat { grid-template-columns: 1fr; grid-template-rows: 45svh auto; align-content: start; }
    .flat__art { order: 0; }
    .flat__text { order: 1; padding-block: 1rem 3rem; }
    .flat__cutout { left: 50%; translate: -50% 0; height: 95%; }
    .flat__cutout--bleed { left: 0; translate: none; width: 100%; height: auto; bottom: 4%; }
    .flat__prop { left: -10%; width: 120%; bottom: 8%; }
  }
</style>

<script>
  import { gsap } from 'gsap';

  // Depth as the page scrolls: each layer shifts against the panel's own movement by its data-drift share.
  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
    const layers = [...document.querySelectorAll<HTMLElement>('.flat [data-drift]')];
    const tick = () => {
      for (const el of layers) {
        const panel = el.closest<HTMLElement>('.flat')!;
        const offset = panel.getBoundingClientRect().top;
        if (Math.abs(offset) > innerHeight * 1.5) continue;
        el.style.transform = `translateY(${-offset * Number(el.dataset.drift)}px)`;
      }
    };
    gsap.ticker.add(tick);
    return () => {
      gsap.ticker.remove(tick);
      layers.forEach((el) => (el.style.transform = ''));
    };
  });

  // Bleed cutouts roll slowly left to right into place: they start shifted left by part of their width and end at
  // x 0, flush with the screen's left edge. Leaving the panel resets them, so the roll plays again on the way back.
  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
    const rollers = [...document.querySelectorAll<HTMLElement>('.flat [data-roll]')];
    gsap.set(rollers, { xPercent: -18 });
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const el = e.target.querySelector<HTMLElement>('[data-roll]')!;
          if (e.isIntersecting) gsap.to(el, { xPercent: 0, duration: 6, ease: 'power2.out', overwrite: true });
          else gsap.set(el, { xPercent: -18, overwrite: true });
        }
      },
      { threshold: 0.5 },
    );
    rollers.forEach((el) => io.observe(el.closest('.flat')!));
    return () => {
      io.disconnect();
      gsap.set(rollers, { clearProps: 'transform' });
    };
  });
</script>
