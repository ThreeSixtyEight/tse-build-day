---
// The gold line above a heading: the chapter number (when there is one), a dash, then the place and year.
interface Props {
  number?: number;
  text: string;
}

const { number, text } = Astro.props;
---

<p class="eyebrow eyebrow--caps">
  {number !== undefined && <><span class="eyebrow__num">{String(number).padStart(2, '0')}</span> – </>}{text}
</p>
