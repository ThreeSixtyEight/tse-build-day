---
// A chapter's takeaway as its own panel (Build Day Figma, frame 152:212): a tilted poster on the left, and beside
// it a gold "Pass it on" eyebrow over the one thing the visitor can do.
import Eyebrow from './Eyebrow.astro';

interface Props {
  id: string;
  text: string;
  image: { src: string; alt: string };
  // Navy background with white text, to follow a night chapter.
  night?: boolean;
}

const { id, text, image, night } = Astro.props;
---

<section class:list={['pass', night && 'pass--night']} id={id} data-section={id}>
  <img class="pass__img" src={image.src} alt={image.alt} width="239" height="400" loading="lazy" />
  <div class="pass__text align-left">
    <Eyebrow text="Pass it on" />
    <p class="body">{text}</p>
  </div>
</section>

<style>
  .pass {
    --text: #1d1a17;
    --muted: rgb(29 26 23 / 0.7);
    --line: rgb(29 26 23 / 0.2);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding: clamp(3rem, 7vw, 7rem) var(--gutter);
    color: var(--text);
    background: #efe7d8;
  }
  .pass--night {
    --text: #fff;
    --muted: rgb(255 255 255 / 0.75);
    --line: rgb(255 255 255 / 0.25);
    background: #070a18;
  }
  /* 291px wide at 1440, tilted 5° anticlockwise as in the frame. */
  .pass__img { width: clamp(10rem, 20.25vw, 18.25rem); rotate: -4.98deg; }
  .pass__text { flex: 0 1 28rem; }
</style>
