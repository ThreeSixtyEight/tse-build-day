---
// A large quote that sits underneath the section before it. Put both inside a `.lift` wrapper:
// the quote is held on screen (sticky to the bottom) behind the first section, so scrolling lifts that
// section up and off it, as if it had been resting on top. Once it's fully uncovered its words fade in.
// Text, source and date come from src/data/quotes.json: Jon's words only as sourced, dated quotes.
interface Props {
  text: string;
  source: string;
  date: string;
  url?: string;
}

const { text, source, date, url } = Astro.props;
---

<section class="section quote-reveal" id="quote" data-section="quote">
  <figure class="quote-reveal__figure" data-quote-reveal>
    <blockquote><p>“{text}”</p></blockquote>
    <figcaption>{url ? <a href={url}>{source}</a> : source}, {date}</figcaption>
  </figure>
</section>

<style>
  /* The wrapper bounds the sticky quote; the section before it stays on top and casts a shadow as it lifts.
     That section's content sits on its bottom edge, so the quote shows right below it (the piano's keys). */
  :global(.lift) { position: relative; }
  :global(.lift > .section:first-child) {
    position: relative;
    z-index: 1;
    justify-content: flex-end;
    padding-bottom: 0;
    /* The negative spread keeps the shadow below the section, off whatever sits above it. */
    box-shadow: 0 40px 60px -20px rgba(0, 0, 0, 0.6);
  }

  .quote-reveal {
    position: sticky;
    bottom: 0;
    z-index: 0;
    display: grid;
    /* One column the width of the section, so the quote wraps inside it instead of widening the page. */
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    height: 100svh;
    overflow-x: clip;
    padding: 4rem var(--gutter);
    background: radial-gradient(ellipse 80% 70% at 50% 45%, #3b1f42, #140b17 75%);
    color: #f6e2cf;
  }
  .quote-reveal__figure { width: min(100%, 14em); margin: 0; text-align: center; font-size: clamp(2.75rem, 8vw, 7.5rem); }
  .quote-reveal blockquote { margin: 0; }
  .quote-reveal blockquote p {
    margin: 0;
    font-family: 'Melodrama', Georgia, serif;
    font-weight: 700;
    font-size: 1em;
    line-height: 0.98;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .quote-reveal figcaption {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    font-family: 'Excon', system-ui, sans-serif;
    font-size: clamp(0.875rem, 1.3vw, 1rem);
    color: #e8a27a;
  }
  .quote-reveal figcaption a { color: inherit; }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';

  gsap.registerPlugin(ScrollTrigger, SplitText);

  // The quote sits centred on screen while the section above lifts off it. Once that section is out of view,
  // the quote's words fade in one after another, then the source.
  // Scrolling back up hides them again, so it plays each time. Reduced motion: the quote is simply there.
  const quote = document.querySelector<HTMLElement>('[data-quote-reveal]');
  const cover = quote?.closest('.lift')?.firstElementChild;
  const text = quote?.querySelector<HTMLElement>('blockquote p');
  if (quote && cover && text) {
    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
      const split = SplitText.create(text, {
        type: 'words',
        // Re-split when the fonts load or the screen resizes, since the lines change.
        autoSplit: true,
        onSplit: (self) =>
          gsap
            .timeline({
              scrollTrigger: {
                trigger: cover,
                // Once the section above has scrolled fully off the screen.
                start: 'bottom top',
                toggleActions: 'play none none reverse',
              },
            })
            .from(self.words, { opacity: 0, y: '0.15em', duration: 0.7, ease: 'power2.out', stagger: 0.08 })
            .from(quote.querySelector('figcaption'), { opacity: 0, duration: 0.6, ease: 'power1.out' }, '-=0.3'),
      });
      return () => split.revert();
    });
  }
</script>
