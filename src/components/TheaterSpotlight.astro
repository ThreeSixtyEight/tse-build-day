---
// Theater scene with a spotlight that follows the pointer: Osmo's Spotlight Cursor (Unicorn Studio) with its
// image swapped for the painted stage (public/theater/stage.jpg). The scene file is public/theater/spotlight.json,
// Osmo's export with the image layer pointed at that painting.
// Unicorn Studio loads when the section is near the screen. It's off on phones (data-us-disablemobile), where the
// dimmed painting shows instead, and the same painting shows if WebGL or the script isn't available.
---

<section class="section theater" id="theater" data-section="theater">
  <div class="theater__fallback" aria-hidden="true"></div>
  <div
    class="spotlight-cursor__wrap"
    data-us-project-src="/theater/spotlight.json"
    data-us-disablemobile="true"
    data-us-scale="1"
    data-us-dpi="1"
    data-us-lazyload="false"
    role="img"
    aria-label="Painting of a pianist in a green striped suit at a grand piano in a pool of light, facing rows of empty red theater seats"
  >
  </div>
</section>

<style>
  .theater {
    position: relative;
    min-height: 100svh;
    padding: 0;
    overflow: hidden;
    background: #000;
  }
  .theater__fallback {
    position: absolute;
    inset: 0;
    background: url(/theater/stage.jpg) center / cover no-repeat;
    filter: brightness(0.55);
  }
  /* Once the scene renders it covers the fallback. The scene stretches its image to the box it's given, so the box
     keeps the painting's proportions and covers the section, cropped at the edges like the fallback. */
  .spotlight-cursor__wrap {
    position: absolute;
    left: 50%;
    top: 50%;
    width: max(100%, 100svh * 1992 / 1121);
    aspect-ratio: 1992 / 1121;
    translate: -50% -50%;
  }
</style>

<script>
  // Unicorn Studio, pinned to the version Osmo built the resource on.
  const SRC = 'https://cdn.jsdelivr.net/gh/hiunicornstudio/unicornstudio.js@v2.2.7/dist/unicornStudio.umd.js';

  declare global {
    interface Window {
      UnicornStudio?: { init: () => Promise<unknown> };
    }
  }

  function initUnicornStudio() {
    window.UnicornStudio?.init()
      .then(() => {
        // Unicorn scene is ready.
      })
      .catch((err) => {
        console.error(err);
      });
  }

  function load() {
    if (window.UnicornStudio) return initUnicornStudio();
    const script = document.createElement('script');
    script.src = SRC;
    script.onload = initUnicornStudio;
    document.head.append(script);
  }

  const section = document.querySelector('#theater');
  if (section) {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        load();
      },
      { rootMargin: '100% 0px' },
    );
    io.observe(section);
  }
</script>
