---
// Playable piano, after Codrops' Musical Interactions piano (github.com/codrops/MusicalInteractions).
// The piano is a painting (public/piano/painted-keys.jpg, 2000 × 646, cropped just below the keys) with an invisible key over each painted key.
// Key positions below are measured from the painting, in its pixels. It runs E3 to E6; the last E is cut off by
// the painting's edge but still plays. Narrower screens crop the painting to fewer keys instead of squashing it.
// Sound is a grand piano: Salamander Grand Piano samples (Alexander Holm, CC BY 3.0) in public/piano/samples,
// played with Tone.js's Sampler, which fills in the notes between samples. Loaded on first use; follows the site's
// sound switch (scripts/sound.ts).
const IMG = { src: '/piano/painted-keys.jpg', w: 2000, h: 646 };
const WHITE_BOTTOM = 636;
const BLACK_BOTTOM = 425;

// Left edges of the white keys; each key runs to the next edge, the last to the painting's edge.
const whiteEdges = [12, 105, 198, 291, 385, 478, 571, 664, 757, 850, 945, 1037, 1130, 1224, 1320, 1412, 1507, 1595, 1681, 1774, 1867, 1955];
const whiteNotes = ['E3', 'F3', 'G3', 'A3', 'B3', 'C4', 'D4', 'E4', 'F4', 'G4', 'A4', 'B4', 'C5', 'D5', 'E5', 'F5', 'G5', 'A5', 'B5', 'C6', 'D6', 'E6'];
const naturals = whiteNotes.map((note, i) => ({ note, x: whiteEdges[i], w: (whiteEdges[i + 1] ?? IMG.w) - whiteEdges[i] }));
// The partial key at the far left (0–12) belongs to D3, which the painting cuts off; it isn't playable.

// Black keys as painted: [note, left, right].
const sharps = (
  [
    ['D#3', 0, 49], ['F#3', 148, 212], ['G#3', 257, 319], ['A#3', 360, 420],
    ['C#4', 526, 588], ['D#4', 638, 703], ['F#4', 806, 868], ['G#4', 912, 975], ['A#4', 1022, 1083],
    ['C#5', 1194, 1255], ['D#5', 1309, 1370], ['F#5', 1465, 1526], ['G#5', 1571, 1636], ['A#5', 1674, 1736],
    ['C#6', 1829, 1892], ['D#6', 1939, 2000],
  ] as const
).map(([note, x0, x1]) => ({ note, x: x0, w: x1 - x0 }));
---

<div class="piano" data-piano data-white-edges={JSON.stringify(whiteEdges)} data-image-width={IMG.w}>
  <!-- The hint sits above the keys, so nothing hangs below them. -->
  <p id="piano-hint" class="piano__hint wrap">Play along: tap the keys, or click and type.</p>
  <svg
    class="piano__inner"
    viewBox={`0 0 ${IMG.w} ${IMG.h}`}
    tabindex="0"
    role="group"
    aria-label="Piano. Press letter and number keys to play."
    aria-describedby="piano-hint"
  >
    <image href={IMG.src} width={IMG.w} height={IMG.h} preserveAspectRatio="none" />
    <g class="piano__keys piano__keys--natural">
      {naturals.map((k) => <rect class="piano__key piano__key--natural" data-note={k.note} x={k.x} y="0" width={k.w} height={WHITE_BOTTOM} />)}
    </g>
    <g class="piano__keys piano__keys--flat">
      {sharps.map((k) => <rect class="piano__key piano__key--flat" data-note={k.note} x={k.x} y="0" width={k.w} height={BLACK_BOTTOM} rx="6" />)}
    </g>
  </svg>
</div>

<style>
  .piano { position: relative; width: 100%; user-select: none; -webkit-user-select: none; }

  /* The painting runs edge to edge; its top fades into the section and it stops right below the keys. */
  .piano__inner {
    display: block;
    width: 100%;
    height: auto;
    touch-action: manipulation;
    mask-image: linear-gradient(to bottom, transparent, #000 6%);
  }
  .piano__inner:focus { outline: none; }
  .piano__inner:focus-visible { outline: 2px solid #f4f1ea; outline-offset: -4px; }

  /* Invisible keys over the painted ones. A pressed white key takes a purple wash, a black key a warm glow. */
  .piano__key { fill: transparent; cursor: pointer; transition: fill 120ms ease; }
  .piano__key--natural { mix-blend-mode: multiply; }
  .piano__key--flat { mix-blend-mode: screen; }
  .piano__key--natural.piano__key--active { fill: rgba(120, 70, 170, 0.65); transition: none; }
  .piano__key--flat.piano__key--active { fill: rgba(255, 170, 100, 0.45); transition: none; }

  /* Set like the section headings: Gunter, uppercase, heading size. */
  .piano__hint {
    margin: 0 auto 1.25rem;
    font-family: 'gunter', 'Melodrama', serif;
    font-weight: 400;
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 0.95;
    text-transform: uppercase;
    text-align: center;
    color: var(--muted);
  }
</style>

<script>
  import type { Sampler } from 'tone';
  import { isSoundOn, setSound, soundChoiceMade } from '../scripts/sound';

  // One Salamander sample every three semitones across the piano's range; the Sampler pitches the rest.
  const SAMPLES = ['A2', 'C3', 'D#3', 'F#3', 'A3', 'C4', 'D#4', 'F#4', 'A4', 'C5', 'D#5', 'F#5', 'A5', 'C6', 'D#6', 'F#6', 'A6'];

  const HINT_ON = 'Play along: tap the keys, or click and type.';
  const HINT_OFF = 'Sound is off. Turn it on to hear the keys.';

  // Codrops' layouts: fewer keys on smaller screens, each with its own letter mapping.
  // `from` and `naturals` pick the white keys to show, counted from the painting's first key (E3).
  const LAYOUTS = [
    { query: '(min-width: 50em)', from: 0, naturals: 22, whites: 'yuiopasdfghjklzxcvbnm,', blacks: "1234567890'qwert" },
    { query: '(min-width: 30em)', from: 5, naturals: 15, whites: 'qwertyuiopasdfg', blacks: '1234567890' },
    { query: 'all', from: 5, naturals: 8, whites: 'qwertyui', blacks: '12345' },
  ];

  function initPiano(root: HTMLElement) {
    const svg = root.querySelector<SVGSVGElement>('svg.piano__inner')!;
    const naturalKeys = [...svg.querySelectorAll<SVGRectElement>('.piano__keys--natural > rect')];
    const flatKeys = [...svg.querySelectorAll<SVGRectElement>('.piano__keys--flat > rect')];
    const allKeys = [...naturalKeys, ...flatKeys];
    const keyByNote = new Map(allKeys.map((k) => [k.dataset.note!, k]));
    const whiteEdges: number[] = JSON.parse(root.dataset.whiteEdges!);
    const imageWidth = Number(root.dataset.imageWidth);
    const imageHeight = Number(svg.viewBox.baseVal.height);

    let keyboardMapping = new Map<string, string>();
    const held = new Set<string>();
    let mouseDown = false;

    // Sound. Tone.js and the piano samples preload when the pointer or focus reaches the piano, and the audio
    // context is started inside the visitor's press.
    // Tone keeps its own context: handing it a native AudioContext breaks in Firefox (no AudioListener.positionX).
    let Tone: typeof import('tone') | undefined;
    let synth: Sampler | undefined;
    let ready: Promise<Sampler> | undefined;
    const loadTone = () =>
      (ready ??= import('tone').then(async (m) => {
        Tone = m;
        const hall = new Tone.Reverb({ decay: 2.2, wet: 0.18 }).toDestination();
        const piano = new Tone.Sampler({
          urls: Object.fromEntries(SAMPLES.map((n) => [n, `${n.replace('#', 's')}.mp3`])),
          baseUrl: '/piano/samples/',
          release: 1.4,
          volume: -4,
        }).connect(hall);
        await Tone.loaded();
        synth = piano;
        return piano;
      }));

    function getSynth() {
      Tone?.start();
      return loadTone().then((piano) => {
        Tone!.start();
        return piano;
      });
    }

    function press(note: string) {
      if (held.has(note)) return;
      // Pressing a key opts the visitor in, unless they've already chosen sound off.
      if (!soundChoiceMade()) setSound(true);
      held.add(note);
      keyByNote.get(note)?.classList.add('piano__key--active');
      if (!isSoundOn()) return;
      getSynth().then((s) => (held.has(note) ? s.triggerAttack(note) : s.triggerAttackRelease(note, '8n')));
    }

    function release(note: string) {
      if (!held.delete(note)) return;
      keyByNote.get(note)?.classList.remove('piano__key--active');
      synth?.triggerRelease(note);
    }

    const releaseAll = () => [...held].forEach(release);
    const noteOf = (ev: Event) => (ev.target as Element).closest<SVGRectElement>('rect[data-note]')?.dataset.note;

    // Mouse and touch. Dragging across keys with the mouse held plays each one.
    svg.addEventListener('pointerdown', (ev) => {
      const note = noteOf(ev);
      if (!note) return;
      mouseDown = ev.pointerType === 'mouse';
      press(note);
    });
    svg.addEventListener('pointerover', (ev) => {
      const note = noteOf(ev);
      if (note && mouseDown) press(note);
    });
    svg.addEventListener('pointerout', (ev) => {
      const note = noteOf(ev);
      if (note && mouseDown) release(note);
    });
    svg.addEventListener('pointerenter', loadTone, { once: true });
    svg.addEventListener('focus', loadTone, { once: true });
    window.addEventListener('pointerup', () => {
      mouseDown = false;
      releaseAll();
    });
    window.addEventListener('pointercancel', releaseAll);

    // Keyboard, only while the piano has focus, so typing elsewhere never makes sound.
    svg.addEventListener('keydown', (ev) => {
      if (ev.metaKey || ev.ctrlKey || ev.altKey) return;
      const note = keyboardMapping.get(ev.key.toLowerCase());
      if (!note) return;
      ev.preventDefault();
      if (!ev.repeat) press(note);
    });
    svg.addEventListener('keyup', (ev) => {
      const note = keyboardMapping.get(ev.key.toLowerCase());
      if (note) release(note);
    });
    svg.addEventListener('blur', releaseAll);

    // Crop the painting to the layout's keys and map the letters to them.
    function applyLayout() {
      const layout = LAYOUTS.find((l) => window.matchMedia(l.query).matches)!;
      const last = layout.from + layout.naturals;
      const x0 = layout.from === 0 ? 0 : whiteEdges[layout.from];
      const x1 = whiteEdges[last] ?? imageWidth;
      svg.setAttribute('viewBox', `${x0} 0 ${x1 - x0} ${imageHeight}`);
      const visibleWhites = naturalKeys.slice(layout.from, last);
      const visibleFlats = flatKeys.filter((k) => {
        const centre = Number(k.getAttribute('x')) + Number(k.getAttribute('width')) / 2;
        return centre > whiteEdges[layout.from] && centre < x1;
      });
      keyboardMapping = new Map([
        ...[...layout.whites].slice(0, visibleWhites.length).map((c, i) => [c, visibleWhites[i].dataset.note!] as const),
        ...[...layout.blacks].slice(0, visibleFlats.length).map((c, i) => [c, visibleFlats[i].dataset.note!] as const),
      ]);
      releaseAll();
    }

    LAYOUTS.forEach((l) => window.matchMedia(l.query).addEventListener('change', applyLayout));
    applyLayout();

    // Follow the site's sound switch: silence the piano at once when it goes off.
    const hint = root.querySelector('.piano__hint')!;
    const updateHint = () => (hint.textContent = isSoundOn() || !soundChoiceMade() ? HINT_ON : HINT_OFF);
    document.addEventListener('sound:change', () => {
      if (isSoundOn()) {
        Tone?.start();
      } else {
        synth?.releaseAll();
        (Tone?.getContext().rawContext as AudioContext | undefined)?.suspend();
      }
      updateHint();
    });
    updateHint();
  }

  document.querySelectorAll<HTMLElement>('[data-piano]').forEach(initPiano);
</script>
