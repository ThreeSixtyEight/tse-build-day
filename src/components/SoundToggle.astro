---
// Sound on/off, fixed to the bottom right corner: the site's blue roll button (Build Day Figma, frame 10474:249),
// labelled with what a click does, "Sound On" while sound is off and "Sound Off" while it's on.
// Hidden until the visitor makes a choice, usually with the hero's "Start The Music" button.
// Wired up in scripts/sound.ts.
import RollButton from './RollButton.astro';
---

<RollButton tone="blue" label="Sound On" class="sound-toggle" data-sound-toggle inert />

<script>
  import '../scripts/sound';
</script>

<style>
  /* button.roll.… to outweigh RollButton's own scoped styles. Outfit Light 18px as in the design. */
  :global(button.roll.sound-toggle) {
    position: fixed;
    right: var(--gutter);
    bottom: var(--gutter);
    z-index: 50;
    font: 300 18px / 1.5 var(--font-body);
    letter-spacing: -0.02em;
    /* A faint light edge and glow around the pill, so it still shows on dark sections. */
    filter: drop-shadow(0 0 1px rgb(255 255 255 / 0.4)) drop-shadow(0 0 10px rgb(255 184 0 / 0.15));
    transition: opacity 400ms ease, translate 400ms ease, visibility 0s 400ms;
  }
  :global(button.roll.sound-toggle:not(.is-shown)) { opacity: 0; translate: 0 12px; visibility: hidden; }
  :global(button.roll.sound-toggle.is-shown) { transition-delay: 0s; }
</style>
