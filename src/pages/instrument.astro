---
// Instruments: built from the Build Day Figma design (file nQtBzavYKQTFVBcSVrPy8T, frame 60:369).
// Four instruments float around a centred title, question and button on dark green.
// The melodica and tambourine carry the design's painted (impasto) effect: they are Figma's renders of those
// layers, rotation included, cut out with the original images' alpha. The trumpet and sousaphone have no effect,
// so they are the original images, rotated here as in the design.
// Hovering or tapping an instrument plays a short synth sound for it when sound is on.
// Positions and sizes are the design's, as percentages of its 1440 × 900 frame; the stage crops what runs off it.
import BaseLayout from '../layouts/BaseLayout.astro';
import RollButton from '../components/RollButton.astro';

type Instrument = {
  id: string;
  name: string;
  src: string;
  // The layer's box in the design frame.
  box: { left: number; top: number; w: number; h: number };
  // The image inside the box when it's rotated here rather than baked in.
  inner?: { w: number; h: number; transform: string };
  depth: number;
};
const instruments: Instrument[] = [
  { id: 'melodica', name: 'Melodica', src: '/instrument/melodica.webp', box: { left: 4.95, top: 125.96, w: 451.98, h: 252.27 }, depth: 18 },
  {
    id: 'trumpet',
    name: 'Trumpet',
    src: '/instrument/trumpet.webp',
    box: { left: 808.92, top: -115.68, w: 449.355, h: 301.494 },
    inner: { w: 414.847, h: 231.542, transform: 'rotate(-10.22deg)' },
    depth: 12,
  },
  { id: 'tambourine', name: 'Tambourine', src: '/instrument/tambourine.webp', box: { left: 1028.81, top: 441.37, w: 304.35, h: 266.01 }, depth: 24 },
  {
    id: 'sousaphone',
    name: 'Sousaphone',
    src: '/instrument/sousaphone.webp',
    box: { left: 239.14, top: 611.31, w: 432.686, h: 444.105 },
    inner: { w: 398.32, h: 222.318, transform: 'rotate(47.63deg) scaleY(-1)' },
    depth: 10,
  },
];
const pct = (n: number, of: number) => `${((n / of) * 100).toFixed(3)}%`;
const place = ({ box, depth }: Instrument) =>
  `left: ${pct(box.left, 1440)}; top: ${pct(box.top, 900)}; width: ${pct(box.w, 1440)}; aspect-ratio: ${box.w} / ${box.h}; --depth: ${depth}`;
const fit = ({ box, inner }: Instrument) =>
  inner && `width: ${pct(inner.w, box.w)}; aspect-ratio: ${inner.w} / ${inner.h}; transform: ${inner.transform}`;
---

<BaseLayout title="Instruments">
  <Fragment slot="head">
    <!-- Excon, the design's body face, loads site-wide. Arnika (headline) isn't freely licensed; Gambetta stands in until Design supplies it. -->
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=gambetta@400&display=swap" />
  </Fragment>

  <section class="stage" data-section="instrument" data-stage>
    {
      instruments.map((i, n) => (
        <button type="button" class="stage__instrument" style={`${place(i)}; --n: ${n}`} data-instrument={i.id} aria-label={`Play the ${i.name.toLowerCase()}`}>
          <span class="stage__float">
            <img src={i.src} alt="" draggable="false" class:list={[i.inner && 'is-rotated']} style={fit(i)} />
          </span>
        </button>
      ))
    }

    <div class="stage__content">
      <div class="stage__text">
        <h1 class="stage__title">The story of Jon Batiste</h1>
        <p class="stage__body">
          How might we tell Jon's story so that it also shows what it means to be New Orleans, with the culture at the
          center instead of in the background?
        </p>
      </div>
      <RollButton href="/#line" label="Start the story" />
    </div>
  </section>
</BaseLayout>

<style>
  .stage {
    position: relative;
    overflow: hidden;
    min-height: calc(100svh - 4rem);
    display: grid;
    place-items: center;
    padding: 4rem var(--gutter);
    background:
      radial-gradient(ellipse 125% 140% at 0% 1%, rgba(2, 188, 164, 0.25), rgba(2, 188, 164, 0) 70%),
      #002823;
    --px: 0;
    --py: 0;
  }

  .stage__instrument {
    position: absolute;
    z-index: 1;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    /* Drifts against the pointer, more for instruments that sit closer. */
    translate: calc(var(--px) * var(--depth) * -1px) calc(var(--py) * var(--depth) * -1px);
    transition: scale 300ms ease, rotate 300ms ease, filter 300ms ease;
  }
  .stage__float {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: stage-float 6s ease-in-out infinite alternate;
    animation-delay: calc(var(--n) * -1.6s);
  }
  .stage__instrument img { display: block; width: 100%; height: 100%; object-fit: contain; pointer-events: none; }
  .stage__instrument img.is-rotated { flex: none; height: auto; }
  .stage__instrument:hover,
  .stage__instrument.is-playing { scale: 1.06; rotate: -3deg; filter: drop-shadow(0 0 24px rgba(2, 188, 164, 0.35)); }
  .stage__instrument:focus-visible { outline: 2px solid #eaeaea; outline-offset: 4px; }

  @keyframes stage-float {
    from { transform: translateY(-6px) rotate(-1deg); }
    to { transform: translateY(8px) rotate(1.5deg); }
  }

  .stage__content {
    position: relative;
    z-index: 2;
    width: min(546px, 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    text-align: center;
  }
  .stage__text { display: flex; flex-direction: column; gap: 12px; }
  .stage__title {
    margin: 0;
    font-size: 20px;
    line-height: 28px;
    letter-spacing: 0.2px;
    text-transform: uppercase;
    color: #fff;
  }
  .stage__body {
    margin: 0;
    font-family: 'Excon', system-ui, sans-serif;
    font-size: 16px;
    line-height: normal;
    color: #eaeaea;
  }

  /* Narrow screens: instruments grow relative to the width so they still read, and stay clear of the text. */
  @media (max-width: 40em) {
    .stage { min-height: calc(100svh - 4rem); }
    .stage__instrument[data-instrument='melodica'] { width: 55% !important; left: -6% !important; top: 6% !important; }
    .stage__instrument[data-instrument='trumpet'] { width: 58% !important; left: 46% !important; top: -3% !important; }
    .stage__instrument[data-instrument='tambourine'] { width: 38% !important; left: 62% !important; top: 70% !important; }
    .stage__instrument[data-instrument='sousaphone'] { width: 55% !important; left: 2% !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage__instrument { translate: none; transition: none; }
    .stage__float { animation: none; }
  }
</style>

<script>
  import type * as ToneNS from 'tone';
  import { isSoundOn } from '../scripts/sound';

  const stage = document.querySelector<HTMLElement>('[data-stage]')!;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---------- Parallax: instruments drift a little with the pointer ----------
  if (!reduceMotion) {
    stage.addEventListener('pointermove', (ev) => {
      const r = stage.getBoundingClientRect();
      stage.style.setProperty('--px', (((ev.clientX - r.left) / r.width) * 2 - 1).toFixed(3));
      stage.style.setProperty('--py', (((ev.clientY - r.top) / r.height) * 2 - 1).toFixed(3));
    });
    stage.addEventListener('pointerleave', () => {
      stage.style.setProperty('--px', '0');
      stage.style.setProperty('--py', '0');
    });
  }

  // ---------- Sound: one short synth phrase per instrument ----------
  type Players = Record<string, (t: number) => void>;
  let players: Promise<{ Tone: typeof ToneNS; play: Players }> | undefined;

  const load = () =>
    (players ??= import('tone').then((Tone) => {
      const out = new Tone.Volume(-8).toDestination();
      const room = new Tone.Reverb({ decay: 2, wet: 0.2 }).connect(out);
      const trumpet = new Tone.MonoSynth({
        oscillator: { type: 'sawtooth' },
        filter: { type: 'lowpass', Q: 2 },
        filterEnvelope: { attack: 0.03, decay: 0.2, sustain: 0.6, baseFrequency: 600, octaves: 2.5 },
        envelope: { attack: 0.03, decay: 0.1, sustain: 0.7, release: 0.2 },
        volume: -6,
      }).connect(room);
      const jingle = new Tone.MetalSynth({ envelope: { attack: 0.001, decay: 0.18, release: 0.05 }, harmonicity: 8, resonance: 5000, volume: -22 }).connect(room);
      const skin = new Tone.MembraneSynth({ pitchDecay: 0.02, octaves: 2, volume: -10 }).connect(room);
      const melodica = new Tone.PolySynth(Tone.Synth, {
        oscillator: { type: 'square' },
        envelope: { attack: 0.04, decay: 0.2, sustain: 0.6, release: 0.3 },
        volume: -20,
      }).connect(new Tone.Filter(1800, 'lowpass').connect(room));
      const tuba = new Tone.MonoSynth({
        oscillator: { type: 'sawtooth' },
        filter: { type: 'lowpass', Q: 1 },
        filterEnvelope: { attack: 0.02, decay: 0.3, sustain: 0.4, baseFrequency: 110, octaves: 2.2 },
        envelope: { attack: 0.03, decay: 0.2, sustain: 0.6, release: 0.3 },
      }).connect(room);

      const play: Players = {
        trumpet: (t) => ['G4', 'C5', 'E5', 'G5'].forEach((n, i) => trumpet.triggerAttackRelease(n, i === 3 ? '8n' : '16n', t + i * 0.12)),
        tambourine: (t) => {
          skin.triggerAttackRelease('A2', '16n', t);
          [0, 0.1, 0.2, 0.35].forEach((d) => jingle.triggerAttackRelease('C6', '32n', t + d));
        },
        melodica: (t) => melodica.triggerAttackRelease(['C4', 'E4', 'G4', 'B4'], '4n', t),
        sousaphone: (t) => {
          tuba.triggerAttackRelease('F1', '8n', t);
          tuba.triggerAttackRelease('A1', '8n', t + 0.22);
          tuba.triggerAttackRelease('C2', '4n', t + 0.44);
        },
      };
      return { Tone, play };
    }));

  const last = new Map<string, number>();
  async function play(button: HTMLElement) {
    const id = button.dataset.instrument!;
    // Don't restart an instrument that's still sounding.
    const now = performance.now();
    if (now - (last.get(id) ?? 0) < 700) return;
    last.set(id, now);

    button.classList.add('is-playing');
    window.setTimeout(() => button.classList.remove('is-playing'), 500);
    if (!isSoundOn()) return;
    const { Tone, play } = await load();
    Tone.start();
    play[id]?.(Tone.now() + 0.02);
  }

  stage.querySelectorAll<HTMLButtonElement>('[data-instrument]').forEach((button) => {
    button.addEventListener('mouseenter', () => play(button));
    button.addEventListener('click', () => play(button));
  });

  if (isSoundOn()) load();
  document.addEventListener('sound:change', () => isSoundOn() && load());
</script>
