---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getServices, getTeam } from '../lib/content';
import { cdn } from '../lib/images';

const team = await getTeam();
const services = await getServices();
const initials = (name: string) => name.split(' ').map((p) => p[0]).join('');
---

<BaseLayout title="Studio" description="Meet the strategists, designers and engineers behind Three Sixty Eight.">
  <section class="wrap intro">
    <p class="label">About the studio</p>
    <h1 class="display">A full turn, <span class="serif">and then some.</span></h1>
    <div class="intro__cols">
      <p>
        360 degrees gets you all the way around a problem. The extra eight is where the interesting stuff happens — the
        idea nobody asked for, the detail nobody expected, the push that turns good work into work people talk about.
      </p>
      <p>
        We're independent, deliberately small, and allergic to handoffs. Every project is staffed by the people you meet
        on day one, from first workshop to launch.
      </p>
    </div>
  </section>

  <figure class="banner reveal">
    <img
      src={cdn('/img/studio.png', 1800, { height: 760 })}
      srcset={`${cdn('/img/studio.png', 900, { height: 380 })} 900w, ${cdn('/img/studio.png', 1800, { height: 760 })} 1800w`}
      sizes="100vw"
      alt="The studio table covered in printed layouts and moodboards during a workshop"
      width="1800"
      height="760"
      loading="lazy"
    />
  </figure>

  <section class="wrap">
    <div class="section-head">
      <h2 class="display">The <span class="serif">people</span></h2>
      <span class="label">{team.length} humans</span>
    </div>
    <ul class="team">
      {
        team.map((m, i) => (
          <li class="member reveal" style={`transition-delay:${(i % 3) * 80}ms`}>
            <div class="avatar" aria-hidden="true">{initials(m.data.name)}</div>
            <h3>{m.data.name}</h3>
            <p class="label role">{m.data.role}</p>
            <p class="bio">{m.data.bio}</p>
            <p class="label tool">Weapon of choice: {m.data.favouriteTool}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap capabilities">
    <div class="section-head">
      <h2 class="display">Capa<span class="serif">bilities</span></h2>
    </div>
    <div class="caps">
      {
        services.map((s) => (
          <div class="reveal">
            <h3>{s.data.title}</h3>
            <ul>{s.data.capabilities.map((c) => <li>{c}</li>)}</ul>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .intro { padding-block: clamp(3rem, 8vw, 6rem); }
  .intro .label { color: var(--ink-soft); margin: 0 0 1.25rem; }
  h1 { font-size: clamp(3.25rem, 10vw, 9.5rem); max-width: 12ch; animation: rise 1s var(--ease) both; }
  h1 .serif { color: var(--signal); font-weight: 400; }
  .intro__cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; max-width: 60rem; margin-left: auto; margin-top: 3rem; font-size: 1.15rem; }
  .intro__cols p { margin: 0; }
  .banner { margin: 0 0 clamp(4rem, 9vw, 7rem); }
  .banner img { width: 100%; aspect-ratio: 1800 / 760; object-fit: cover; }
  .team { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .member { background: var(--paper); padding: 2rem; transition: background 0.4s var(--ease); }
  .member:hover { background: var(--paper-2); }
  .avatar {
    width: 4.5rem; height: 4.5rem; border-radius: 50%; display: grid; place-items: center;
    background: var(--ink); color: var(--paper); font-weight: 700; font-size: 1.3rem; letter-spacing: -0.04em;
    margin-bottom: 1.5rem; transition: background 0.4s, color 0.4s, transform 0.6s var(--ease);
  }
  .member:hover .avatar { background: var(--signal); color: var(--ink); transform: rotate(-12deg); }
  .member h3 { margin: 0; font-size: 1.6rem; letter-spacing: -0.035em; font-weight: 600; }
  .role { color: var(--signal); margin: 0.3rem 0 1rem; }
  .bio { margin: 0 0 1.25rem; color: var(--ink-soft); }
  .tool { margin: 0; font-size: 0.68rem; color: var(--ink-soft); }
  .capabilities { margin-top: clamp(5rem, 10vw, 8rem); }
  .caps { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2.5rem; }
  .caps h3 { margin: 0 0 1rem; font-size: 1.35rem; letter-spacing: -0.03em; padding-bottom: 0.75rem; border-bottom: 2px solid var(--ink); }
  .caps ul { list-style: none; margin: 0; padding: 0; }
  .caps li { padding: 0.45rem 0; border-bottom: 1px solid var(--line); }
  @media (max-width: 760px) { .intro__cols { grid-template-columns: 1fr; } }
</style>
