---
import { getCollection, getEntries, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Notes from '../components/Notes.astro';
import Quote from '../components/Quote.astro';
import Piano from '../components/Piano.astro';
import TheaterSpotlight from '../components/TheaterSpotlight.astro';
import { site } from '../site.config';

const sections = (await getCollection('sections')).sort((a, b) => a.data.order - b.data.order);
const credits = await getCollection('credits');
const allQuotes = await getCollection('quotes');
const rendered = await Promise.all(
  sections.map(async (s) => ({
    s,
    Content: (await render(s)).Content,
    quotes: await getEntries(s.data.quotes),
  })),
);

// Placeholder backgrounds: free Unsplash photos of New Orleans, by section id, credited in src/data/credits.json.
// ponytail: one 2000px image for every screen, add a srcset-style image-set when the final photos land.
const photos: Record<string, string> = {
  entry: '1525994886773-080587e161c2',
  'section-2': '1640583430339-f83d93e77413',
  'section-3': '1771868557440-ab1f8e4d6006',
  // Reused until final photos land: the transcript street for the homecoming, the entry street for the send-off.
  'section-4': '1775227970630-9c03b7406132',
  'section-5': '1525994886773-080587e161c2',
  listen: '1560110734-f03640ca8eda',
  end: '1690267306076-2a6e9899aaeb',
  transcript: '1775227970630-9c03b7406132',
  credits: '1767468200550-e6945e9b7f5f',
};
const photoVar = (photo: string) =>
  `--photo: url(https://images.unsplash.com/photo-${photo}?w=2000&q=70&auto=format&fit=crop)`;
const bg = (id: string) => photos[id] && photoVar(photos[id]);
---

<BaseLayout>
  <!-- Hero art from Figma (Build Day, frame 60:276), layers in public/hero. Positions are % of the 1440×900 frame. -->
  <!-- Three screens tall: the art stays pinned while scrolling drops Jon and lifts the title away, then pans right along the street
       to Jon leading the second line (Figma Frame 47 → Frame 51). -->
  <section class="hero" id="entry" data-section="entry">
    <!-- Hide the layers until the load-in plays; shown anyway after 3s in case the script fails. -->
    <script is:inline>
      document.documentElement.classList.add('hero-intro');
      setTimeout(() => document.documentElement.classList.remove('hero-intro'), 3000);
    </script>
    <div class="hero__pin">
      <div class="hero__stage">
        <!-- Sky animation loops silently behind the art. No poster: sky.webp is the whole street scene, so it doubled the buildings while the video buffered. -->
        <video class="hero__sky" src="/hero/sky.mp4" autoplay muted loop playsinline disablepictureinpicture aria-hidden="true"></video>
        <!-- The street and the parade on it move as one layer. -->
        <div class="hero__street">
          <img src="/hero/street.webp" alt="" />
          <img class="hero__parade" src="/hero/parade.webp" alt="Jon Batiste leading a second line brass band down the street" />
        </div>
        <h1 class="hero__title">
          <span class="hero__line"><span class="hero__small">The</span> Story <span class="hero__small">of</span></span>
          Jon Batiste
        </h1>
        <img class="hero__jon" src="/hero/jon.webp" alt="Painted portrait of Jon Batiste on a New Orleans street" />
      </div>
      <div class="hero__border" aria-hidden="true"></div>
    </div>
  </section>

  <!-- The second line: one section per file in src/content/sections. A chapter with scenes gets one full-screen panel per scene. -->
  <div id="line">
    {
      rendered.map(({ s, Content, quotes }) =>
        s.data.scenes.length ? (
          s.data.scenes.map((scene, i) => {
            const last = i === s.data.scenes.length - 1;
            return (
              <section
                class="section scene"
                id={i ? `${s.id}-${i + 1}` : s.id}
                data-section={s.id}
                data-scene={i + 1}
                style={scene.photo && photoVar(scene.photo)}
              >
                <div class="wrap">
                  {i === 0 && <h2>{s.data.title}</h2>}
                  <p class="scene__text">{scene.text}</p>
                  {i === 0 && s.data.caption && <p class="caption">{s.data.caption}</p>}
                  {last && quotes.map((q) => <Quote {...q.data} />)}
                  {last && (
                    <Notes
                      items={[
                        `Purpose: ${s.data.purpose}`,
                        `Directives: ${s.data.directives.length ? s.data.directives.join(', ') : 'TBD'}`,
                        `Key interaction: ${s.data.interaction}`,
                      ]}
                    />
                  )}
                </div>
              </section>
            );
          })
        ) : (
          <section class="section" id={s.id} data-section={s.id} style={bg(s.id)}>
            <div class="wrap">
              <h2>{s.data.title}</h2>
              <Content />
              {quotes.map((q) => (
                <Quote {...q.data} />
              ))}
              {s.data.caption && <p class="caption">{s.data.caption}</p>}
              <Notes
                items={[
                  `Purpose: ${s.data.purpose}`,
                  `Directives: ${s.data.directives.length ? s.data.directives.join(', ') : 'TBD'}`,
                  `Key interaction: ${s.data.interaction}`,
                  `Main content type: ${s.data.media ?? 'TBD'}`,
                ]}
              />
            </div>
          </section>
        ),
      )
    }
  </div>

  <!-- The piano: play along after the second line. -->
  <section class="section" id="piano" data-section="piano">
    <Piano />
  </section>

  <!-- The theater: a spotlight follows the pointer across Jon at the piano. -->
  <TheaterSpotlight />

  <section class="section" id="listen" data-section="listen" style={bg('listen')}>
    <div class="wrap">
      <h2>Listen</h2>
      <!-- Official Spotify artist embed: only Jon Batiste's own catalogue plays here. -->
      <iframe
        class="spotify"
        title="Jon Batiste on Spotify"
        src="https://open.spotify.com/embed/artist/0eRbECAGCLLiTyVXPBRexU?utm_source=generator"
        width="100%"
        height="352"
        frameborder="0"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"
        data-embed="spotify"
      ></iframe>
      <Notes
        items={[
          'Ending: We Are through an official embed, the only place Jon\'s music plays. Swap the artist embed for We Are.',
          'Official Spotify, Apple Music or YouTube embeds only. No AI voice or AI music.',
          'Analytics: embed clicks.',
        ]}
      />
    </div>
  </section>

  <!-- End of the line. Reaching this section is tracked. -->
  <section class="section" id="end" data-section="end" style={bg('end')}>
    <div class="wrap">
      <h2>End of the line</h2>
      <p>For music, tour dates and the store, visit <a href={site.officialSite}>Jon Batiste's official site</a>.</p>
      <Notes
        items={[
          "His site already handles the store, newsletter and tour, so we link out rather than rebuild them.",
          'Analytics: visitor reaches the end.',
        ]}
      />
    </div>
  </section>

  <!-- Transcript: everything spoken, sung or heard, section by section. -->
  <section class="section" id="transcript" data-section="transcript" style={bg('transcript')}>
    <div class="wrap">
      <h2>Transcript</h2>
      <Notes items={['Captions and transcripts are checked by Strategists before launch.']} />
      {
        sections.map((s) => (
          <article class="entry">
            <h3><a href={`#${s.id}`}>{s.data.title}</a></h3>
            <p>{s.data.transcript ?? 'Transcript to come.'}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Credits: every photo, clip, embed and quote on the site. -->
  <section class="section" id="credits" data-section="credits" style={bg('credits')}>
    <div class="wrap">
      <h2>Credits</h2>
      <Notes
        items={[
          'Licensed photos only, credited.',
          'Club names, regalia, footage and music need permission or a credited source.',
        ]}
      />
      <h3>Media</h3>
      {
        credits.length ? (
          <ul>
            {credits.map(({ data }) => (
              <li>
                {data.item} ({data.type}): {data.url ? <a href={data.url}>{data.credit}</a> : data.credit}
              </li>
            ))}
          </ul>
        ) : (
          <p>Credits to come.</p>
        )
      }
      <h3>Quotes</h3>
      {
        allQuotes.length ? (
          <ul>
            {allQuotes.map(({ data }) => (
              <li>{data.url ? <a href={data.url}>{data.source}</a> : data.source}, {data.date}</li>
            ))}
          </ul>
        ) : (
          <p>Quote sources to come.</p>
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Scroll from the hero to the street: the street rises from below the screen, bringing the head of the parade into view,
  // as the title lifts away 806px of the 1440-wide frame and Jon drops out. Then the street pans right until its right edge meets the screen's, revealing the parade, but no further than Jon at the head of it
  // (on a phone the street runs on well past him). The art is pinned by CSS sticky.
  const stage = document.querySelector<HTMLElement>('.hero__stage');
  const street = document.querySelector<HTMLElement>('.hero__street')!;
  const parade = street.querySelector<HTMLElement>('.hero__parade')!;
  const pan = () => {
    // The stage is centred, so it may be cropped at the sides.
    const stageLeft = (innerWidth - stage!.offsetWidth) / 2;
    const toEdge = stageLeft + street.offsetLeft + street.offsetWidth - innerWidth;
    const toJon = stageLeft + street.offsetLeft + parade.offsetLeft - innerWidth * 0.05;
    return Math.max(0, Math.min(toEdge, toJon));
  };
  // How far the street starts below where it settles: just enough to hide the parade under the bottom of the screen.
  const drop = () => {
    const stageTop = (innerHeight - stage!.offsetHeight) / 2;
    return Math.max(0, innerHeight - (stageTop + street.offsetTop + parade.offsetTop));
  };

  // Reduced motion: hold the sky on its first frame.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelector<HTMLVideoElement>('.hero__sky')?.pause();
  }
  const frame = () => stage!.offsetWidth / 1440;

  // Load-in: the street rises, then the title drops in from above as Jon rises from below. Slides only, no fades.
  // Uses yPercent so it stacks with the scroll tween's y.
  const layers = [...stage!.querySelectorAll('img')];
  Promise.all([document.fonts.ready, ...layers.map((img) => img.decode().catch(() => {}))]).then(() => {
    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
      gsap
        .timeline({ defaults: { ease: 'power3.out' } })
        .from('.hero__street', { yPercent: 8, duration: 1.4 })
        .from('.hero__title', { yPercent: -220, duration: 1.2 }, '-=0.4')
        .from('.hero__jon', { yPercent: 100, duration: 1.2 }, '<');
    });
    document.documentElement.classList.remove('hero-intro');
  });

  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
    gsap
      .timeline({
        defaults: { ease: 'none' },
        scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom bottom', scrub: true, invalidateOnRefresh: true },
      })
      .from('.hero__street', { y: () => drop(), duration: 1 }, 0)
      .to('.hero__title', { y: () => -806 * frame(), duration: 1 }, 0)
      .to('.hero__jon', { y: () => 720 * frame(), duration: 0.6 }, 0)
      .to('.hero__street', { x: () => -pan(), duration: 1 }, 1);
  });

  // Mouse parallax: the pointer sets --mx/--my (-1 to 1) on the stage and each layer drifts by its own depth (CSS).
  // Mouse and trackpad only; the sky stays still as the farthest layer.
  gsap.matchMedia().add('(prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine)', () => {
    const pin = document.querySelector<HTMLElement>('.hero__pin')!;
    const toX = gsap.quickTo(stage, '--mx', { duration: 0.8, ease: 'power3' });
    const toY = gsap.quickTo(stage, '--my', { duration: 0.8, ease: 'power3' });
    const move = (e: PointerEvent) => {
      toX((e.clientX / innerWidth) * 2 - 1);
      toY((e.clientY / innerHeight) * 2 - 1);
    };
    const reset = () => (toX(0), toY(0));
    pin.addEventListener('pointermove', move);
    pin.addEventListener('pointerleave', reset);
    return () => {
      pin.removeEventListener('pointermove', move);
      pin.removeEventListener('pointerleave', reset);
      gsap.set(stage, { '--mx': 0, '--my': 0 });
    };
  });
</script>

<style>
  /* Cinematic scroll: every section fills the screen and locks into place. Sections taller than the screen still scroll through. */
  :global(html) { scroll-snap-type: y mandatory; }
  .hero, .section { scroll-snap-align: start; }
  :global(.footer) { scroll-snap-align: end; }
  .section { display: flex; flex-direction: column; justify-content: center; min-height: 100svh; }

  /* Hero: the Figma frame scaled to cover the screen, cropped at the sides on tall screens. */
  .hero { position: relative; height: 300svh; background: #8bbdce; }
  .hero__pin { position: sticky; top: 0; height: 100svh; overflow: hidden; }
  /* More snap points: the street scene, then the end of the pan. */
  .hero::before, .hero::after { content: ''; position: absolute; height: 100svh; scroll-snap-align: start; }
  .hero::before { top: 100svh; }
  .hero::after { bottom: 0; }
  .hero__stage {
    position: absolute;
    left: 50%;
    top: 50%;
    width: max(100vw, 160svh);
    aspect-ratio: 1440 / 900;
    translate: -50% -50%;
  }
  .hero__stage > *, .hero__border { position: absolute; margin: 0; }
  :global(html.hero-intro) :is(.hero__street, .hero__jon, .hero__title) { visibility: hidden; }
  /* The sky video is rendered at the frame's 16:10, so it covers the pinned stage edge to edge. */
  .hero__sky { inset: 0; width: 100%; height: 100%; object-fit: cover; max-width: none; }
  /* Street from Figma Frame 47 (2159×1205 at x -359, y -152). The parade sits on it where Frame 51 puts it. */
  .hero__street { left: -24.95%; top: -16.94%; width: 149.91%; height: 133.87%; }
  .hero__street img { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; }
  .hero__street .hero__parade { left: 50.46%; top: 49.96%; width: 46.18%; height: auto; }
  /* Sizes from the Figma frame (big words 97.95px, small 44.24px at 1440 wide), capped so the title fits a phone. Sits behind Jon's head. */
  .hero__stage { container-type: inline-size; }
  .hero__title {
    --u: min(1cqw, 1.667vw);
    left: 0;
    right: 0;
    top: 13.5%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--u) * 2);
    font: 400 calc(var(--u) * 6.8) / 0.8 'gunter', 'Melodrama', serif;
    text-align: center;
    text-transform: uppercase;
    color: #fff;
    /* Figma: 4px 5px 0 at 1440 wide. */
    text-shadow: calc(var(--u) * 0.28) calc(var(--u) * 0.35) 0 rgb(1 86 75 / 0.5);
  }
  .hero__line { display: flex; align-items: baseline; gap: 0.25em; }
  .hero__small { font-family: 'Melodrama', serif; font-weight: 700; font-size: 0.45em; letter-spacing: 0.07em; }
  .hero__jon { left: 11.67%; top: 27%; width: 86.94%; max-width: none; }

  /* Mouse parallax depths: nearer layers drift further, against the pointer.
     !important because GSAP writes translate: none inline on anything it tweens; its own moves go in transform, so the two stack. */
  .hero__stage { --mx: 0; --my: 0; }
  .hero__street { --depth: 0.6cqw; }
  .hero__title { --depth: 1.2cqw; }
  .hero__jon { --depth: 2cqw; }
  .hero__street, .hero__title, .hero__jon {
    translate: calc(var(--mx) * var(--depth) * -1) calc(var(--my) * var(--depth) * -1) !important;
  }


  /* Painted frame: one strip per edge, rotated copies of the Figma border. */
  .hero__border {
    --edge: clamp(20px, 3vw, 44px);
    inset: 0;
    pointer-events: none;
    background:
      url(/hero/border-top.png) top / auto var(--edge) repeat-x,
      url(/hero/border-bottom.png) bottom / auto var(--edge) repeat-x,
      url(/hero/border-left.png) left / var(--edge) auto repeat-y,
      url(/hero/border-right.png) right / var(--edge) auto repeat-y;
  }

  /* Each section sits on a darkened photo, so its text and notes switch to light colours. */
  .section {
    --text: #fff;
    --muted: rgb(255 255 255 / 0.8);
    --line: rgb(255 255 255 / 0.3);
    color: var(--text);
    background: linear-gradient(rgb(0 0 0 / 0.55), rgb(0 0 0 / 0.55)), var(--photo, none) center / cover #222;
  }

  .section { padding-block: 3rem; border-bottom: 1px solid var(--line); }
  .section h2 { margin-top: 0; }
  .caption { color: var(--muted); font-size: 0.875rem; }
  .scene__text { font-size: clamp(1.25rem, 2.2vw, 1.75rem); line-height: 1.45; max-width: 38rem; }
  .spotify { border: 0; border-radius: 12px; max-width: 40rem; }
  .entry { border-top: 1px solid var(--line); margin-top: 1.5rem; padding-top: 1rem; }
  .entry h3, .section h3 { font-size: 1.125rem; margin: 1.5rem 0 0.5rem; }
</style>
