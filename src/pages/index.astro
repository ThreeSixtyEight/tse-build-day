---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Takeaway from '../components/Takeaway.astro';
import Piano from '../components/Piano.astro';
import MusicStaff from '../components/MusicStaff.astro';
import BackgroundMusic from '../components/BackgroundMusic.astro';
import EndOfTheLine from '../components/EndOfTheLine.astro';
import ChapterOpener from '../components/ChapterOpener.astro';
import ChapterAside from '../components/ChapterAside.astro';
import Quote from '../components/Quote.astro';
import RollButton from '../components/RollButton.astro';

const sections = (await getCollection('sections')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  sections.map(async (s) => ({
    s,
    Content: (await render(s)).Content,
    pullQuote: s.data.pullQuote && (await getEntry(s.data.pullQuote))!.data,
  })),
);

// Placeholder backgrounds: free Unsplash photos of New Orleans, by section id, credited in src/data/credits.json.
// ponytail: one 2000px image for every screen, add a srcset-style image-set when the final photos land.
const photos: Record<string, string> = {
  entry: '1525994886773-080587e161c2',
  'section-3': '1771868557440-ab1f8e4d6006',
};
const photoVar = (photo: string) =>
  `--photo: url(https://images.unsplash.com/photo-${photo}?w=2000&q=70&auto=format&fit=crop)`;
const bg = (id: string, own?: string) => (own ? `--photo: url(${own})` : photos[id] && photoVar(photos[id]));
---

<BaseLayout>
  <!-- Hero art from Figma (Build Day, frame 60:276), layers in public/hero. Positions are % of the 1440×900 frame. -->
  <!-- Three screens tall: the art stays pinned while scrolling drops Jon and lifts the title away, then pans right along the street
       to Jon leading the second line (Figma Frame 47 → Frame 51). -->
  <section class="hero" id="entry" data-section="entry">
    <!-- Hide the layers until the load-in plays; shown anyway after 3s in case the script fails. -->
    <script is:inline>
      document.documentElement.classList.add('hero-intro');
      setTimeout(() => document.documentElement.classList.remove('hero-intro'), 3000);
    </script>
    <div class="hero__pin">
      <div class="hero__stage">
        <!-- The sky, street and the parade on it move as one layer; the corner building in front sits over the parade. -->
        <div class="hero__street">
          <!-- Sky animation loops silently behind the art. No poster: sky.webp is the whole street scene, so it doubled the buildings while the video buffered. -->
          <video class="hero__sky" src="/hero/sky.mp4" autoplay muted loop playsinline disablepictureinpicture aria-hidden="true"></video>
          <img src="/hero/street.webp" alt="" />
          <img class="hero__parade" src="/hero/parade.webp" alt="Jon Batiste leading a second line brass band down the street" />
          <img src="/hero/street-front.webp" alt="" />
          <!-- Figma Frame 60 (10405:629): up in the sky above the rooftops, riding with the street; fades in as the street settles. -->
          <p class="hero__invite">When somebody’s worth celebrating, New Orleans takes it to the street. Today the second line is for Jon Batiste, and you’re invited.</p>
        </div>
        <h1 class="hero__title">
          <span class="hero__line"><span class="hero__small">The</span> Story <span class="hero__small">of</span></span>
          Jon Batiste
        </h1>
        <img class="hero__jon" src="/hero/jon.webp" alt="Painted portrait of Jon Batiste on a New Orleans street" />
      </div>
      <div class="hero__border" aria-hidden="true"></div>
      <!-- Turns the music on and off, and stays for the whole hero; the corner sound button takes over below it (scripts/sound.ts). -->
      <div class="hero__audio">
        <RollButton label="Start The Music" data-sound-start />
      </div>
    </div>
  </section>

  <!-- The second line: one section per file in src/content/sections. A chapter with scenes gets one full-screen panel per scene,
       otherwise it starts with its opener, then its asides and pull quote. -->
  <div id="line">
    {
      rendered.map(({ s, Content, pullQuote }) => (
        <>
        {s.data.fullScreen && (s.data.scenes.length ? (
          s.data.scenes.map((scene, i) => {
            const last = i === s.data.scenes.length - 1;
            return (
              <section
                class="section scene"
                id={i ? `${s.id}-${i + 1}` : s.id}
                data-section={s.id}
                data-scene={i + 1}
                style={scene.photo && photoVar(scene.photo)}
              >
                <div class="wrap align-left">
                  {/* No eyebrow on a scene, so no heading. A "[Quote] " marker left in the copy is dropped. */}
                  <p class="body body--xl">{scene.text.replace(/^\[Quote\]\s*/, '')}</p>
                  {i === 0 && s.data.caption && <p class="caption">{s.data.caption}</p>}
                  {last && s.data.takeaway && <Takeaway text={s.data.takeaway} />}
                </div>
              </section>
            );
          })
        ) : (
          <section
            class:list={['section', { 'section--stage': s.data.background, 'section--night': s.data.night }]}
            id={s.id}
            data-section={s.id}
            style={bg(s.id, s.data.background)}
          >
            <div class="wrap align-left">
              {s.data.eyebrow && <Eyebrow number={s.data.order} text={s.data.eyebrow} />}
              {/* A heading only shows under an eyebrow. */}
              {s.data.eyebrow && <h2 class:list={['heading', s.data.night ? 'heading--display' : 'heading--xl']}>{s.data.title}</h2>}
              <div class="body"><Content /></div>
              {s.data.caption && <p class="caption">{s.data.caption}</p>}
              {s.data.takeaway && <Takeaway text={s.data.takeaway} />}
            </div>
          </section>
        ))}
        {s.data.opener && <ChapterOpener id={s.id} number={s.data.order} {...s.data.opener} night={s.data.night} />}
        {s.data.asides.map((aside, i) => (
          <ChapterAside id={`${s.id}-aside${i ? `-${i + 1}` : ''}`} {...aside} night={s.data.night} />
        ))}
        {pullQuote && <Quote id={`${s.id}-quote`} {...pullQuote} night={s.data.night} />}
        {/* Chapter 2 ends with the playable piano. */}
        {s.data.order === 2 && (
          <section class="section section--keys" id="piano" data-section="piano">
            <Piano />
          </section>
        )}
        {/* Chapter 3 ends on the playable music staff, below the love riot quote. */}
        {s.data.order === 3 && <MusicStaff />}
        </>
      ))
    }
  </div>


  <!-- End of the line, from the Build Day Figma: the closing copy among four instruments, then the Spotify player. -->
  <EndOfTheLine />

  <!-- A wedding second line, looping under the page once the visitor turns sound on. -->
  <BackgroundMusic />
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Scroll from the hero to the street: the street rises from below the screen, bringing the head of the parade into view,
  // as the title lifts away 806px of the 1440-wide frame and Jon drops out. Then the street pans right until its right edge meets the screen's, revealing the parade, but no further than Jon at the head of it
  // (on a phone the street runs on well past him). The art is pinned by CSS sticky.
  const stage = document.querySelector<HTMLElement>('.hero__stage');
  const street = document.querySelector<HTMLElement>('.hero__street')!;
  const parade = street.querySelector<HTMLElement>('.hero__parade')!;
  const invite = street.querySelector<HTMLElement>('.hero__invite')!;
  const pan = () => {
    // The stage is centred, so it may be cropped at the sides.
    const stageLeft = (innerWidth - stage!.offsetWidth) / 2;
    const toEdge = stageLeft + street.offsetLeft + street.offsetWidth - innerWidth;
    const toJon = stageLeft + street.offsetLeft + parade.offsetLeft - innerWidth * 0.05;
    return Math.max(0, Math.min(toEdge, toJon));
  };
  // How far the street starts below where it settles: just enough to hide the parade under the bottom of the screen.
  const drop = () => {
    const stageTop = (innerHeight - stage!.offsetHeight) / 2;
    const d = Math.max(0, innerHeight - (stageTop + street.offsetTop + parade.offsetTop));
    // The sky rides with the street, so it reaches up by the same amount to keep the top of the screen covered.
    street.style.setProperty('--drop', `${d}px`);
    return d;
  };
  // Where the street settles: raised until the bottom of the parade is on screen, but never so far that the street's
  // own bottom edge shows (12px spare covers the mouse parallax).
  const lift = () => {
    const stageTop = (innerHeight - stage!.offsetHeight) / 2;
    const top = stageTop + street.offsetTop;
    const toParade = innerHeight - (top + parade.offsetTop + parade.offsetHeight) - innerHeight * 0.02;
    const toEdge = innerHeight + 12 - (top + street.offsetHeight);
    const l = Math.min(0, Math.max(toParade, toEdge));
    // The street settles higher on wider screens, so this tells the invite line's CSS where the top of the screen will
    // be, in the street, once settled. The CSS sets how far below that the line sits.
    invite.style.setProperty('--screen-top', `${-top - l}px`);
    return l;
  };

  // Reduced motion: hold the sky on its first frame.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelector<HTMLVideoElement>('.hero__sky')?.pause();
  }
  const frame = () => stage!.offsetWidth / 1440;

  // Load-in: the street rises, then the title drops in from above as Jon rises from below. Slides only, no fades.
  // Uses yPercent so it stacks with the scroll tween's y.
  const layers = [...stage!.querySelectorAll('img')];
  Promise.all([document.fonts.ready, ...layers.map((img) => img.decode().catch(() => {}))]).then(() => {
    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
      gsap
        .timeline({ defaults: { ease: 'power3.out' } })
        .from('.hero__street', { yPercent: 8, duration: 1.4 })
        .from('.hero__title', { yPercent: -220, duration: 1.2 }, '-=0.4')
        .from('.hero__jon', { yPercent: 100, duration: 1.2 }, '<')
        // The audio button's own fade, so it doesn't fight the scroll fade on its wrapper.
        .fromTo('.hero__audio .roll', { autoAlpha: 0, y: 16 }, { autoAlpha: 1, y: 0, duration: 0.8 }, '-=0.5');
    });
    document.documentElement.classList.remove('hero-intro');
  });

  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
    gsap
      .timeline({
        defaults: { ease: 'none' },
        scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom bottom', scrub: true, invalidateOnRefresh: true },
      })
      .fromTo('.hero__street', { y: () => drop() }, { y: () => lift(), duration: 1 }, 0)
      .to('.hero__title', { y: () => -806 * frame(), duration: 1 }, 0)
      .to('.hero__jon', { y: () => 720 * frame(), duration: 0.6 }, 0)
      // The painted border grows past the screen edges in the first stretch of scrolling.
      .to('.hero__border', { scale: 1.2, duration: 0.25, ease: 'power2.in' }, 0)
      .to('.hero__street', { x: () => -pan(), duration: 1 }, 1)
      // Fades in from the first scroll and is fully in by the time the line rises to the middle of the screen
      // (a tenth of the way through the hero).
      .from('.hero__invite', { autoAlpha: 0, y: 16, duration: 0.2 }, 0);
  });

  // Mouse parallax: the pointer sets --mx/--my (-1 to 1) on the stage and each layer drifts by its own depth (CSS).
  // Mouse and trackpad only; the sky drifts with the street.
  gsap.matchMedia().add('(prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine)', () => {
    const pin = document.querySelector<HTMLElement>('.hero__pin')!;
    const toX = gsap.quickTo(stage, '--mx', { duration: 0.8, ease: 'power3' });
    const toY = gsap.quickTo(stage, '--my', { duration: 0.8, ease: 'power3' });
    const move = (e: PointerEvent) => {
      toX((e.clientX / innerWidth) * 2 - 1);
      toY((e.clientY / innerHeight) * 2 - 1);
    };
    const reset = () => (toX(0), toY(0));
    pin.addEventListener('pointermove', move);
    pin.addEventListener('pointerleave', reset);
    return () => {
      pin.removeEventListener('pointermove', move);
      pin.removeEventListener('pointerleave', reset);
      gsap.set(stage, { '--mx': 0, '--my': 0 });
    };
  });
</script>

<style>
  /* Every section fills the screen; scrolling is free, with no snapping. */
  .section { display: flex; flex-direction: column; justify-content: center; min-height: 100svh; }

  /* Hero: the Figma frame scaled to cover the screen, cropped at the sides on tall screens. */
  .hero { position: relative; height: 300svh; background: #8bbdce; }
  .hero__pin { position: sticky; top: 0; height: 100svh; overflow: hidden; }
  .hero__stage {
    position: absolute;
    left: 50%;
    top: 50%;
    width: max(100vw, 160svh);
    aspect-ratio: 1440 / 900;
    translate: -50% -50%;
  }
  .hero__stage > *, .hero__border { position: absolute; margin: 0; }
  :global(html.hero-intro) :is(.hero__street, .hero__jon, .hero__title, .hero__audio) { visibility: hidden; }
  /* Street from Figma Frame 47 (2159×1205 at x -359, y -152). The parade sits on it where Frame 51 puts it. */
  .hero__street { left: -24.95%; top: -16.94%; width: 149.91%; height: 133.87%; }
  .hero__street :is(img, .hero__sky) { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; }
  /* Rides with the buildings rather than staying pinned. Reaches above the street by its starting drop (--drop, set in the
     script) plus the 8% load-in slide and 12px for the mouse parallax, so no gap shows at the top while it's lowered. */
  .hero__street .hero__sky {
    top: calc(-8% - var(--drop, 0px) - 12px);
    height: calc(108% + var(--drop, 0px) + 12px);
    object-fit: cover;
    object-position: center bottom;
  }
  .hero__street .hero__parade { left: 50.46%; top: 49.96%; width: 46.18%; height: auto; }
  /* Sizes from the Figma frame (big words 97.95px, small 44.24px at 1440 wide), capped so the title fits a phone. Sits behind Jon's head. */
  .hero__stage { container-type: inline-size; }
  .hero__title {
    --u: min(1cqw, 1.667vw);
    left: 0;
    right: 0;
    top: 13.5%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--u) * 2);
    font: 400 calc(var(--u) * 6.8) / 0.8 'gunter', 'Melodrama', serif;
    text-align: center;
    text-transform: uppercase;
    color: #fff;
    /* Figma: 4px 5px 0 at 1440 wide. */
    text-shadow: calc(var(--u) * 0.28) calc(var(--u) * 0.35) 0 rgb(1 86 75 / 0.5);
  }
  .hero__line { display: flex; align-items: baseline; gap: 0.25em; }
  .hero__small { font-family: 'Melodrama', serif; font-weight: 700; font-size: 0.45em; letter-spacing: 0.07em; }
  .hero__jon { left: 11.67%; top: 27%; width: 86.94%; max-width: none; }

  /* Mouse parallax depths: nearer layers drift further, against the pointer.
     !important because GSAP writes translate: none inline on anything it tweens; its own moves go in transform, so the two stack. */
  .hero__stage { --mx: 0; --my: 0; }
  .hero__street { --depth: 0.6cqw; }
  .hero__title { --depth: 1.2cqw; }
  .hero__jon { --depth: 2cqw; }
  .hero__street, .hero__title, .hero__jon {
    translate: calc(var(--mx) * var(--depth) * -1) calc(var(--my) * var(--depth) * -1) !important;
  }


  /* Invite line in the sky (Figma Frame 60, centred, at the Text Large size: 20px), navy, kept narrow and high so it stays
     clear of the buildings. --screen-top (set by the script) is where the top of the screen is once the street settles;
     the line sits the added distance below it. Change that distance to move it up or down. The 25% is the fallback
     when reduced motion skips the scroll. A fixed width, never wider than the screen; the type shrinks to keep it
     within the screen on a phone (16px at the smallest). */
  .hero__street .hero__invite {
    position: absolute;
    left: 50%;
    top: 20%;
    width: 800px;
    max-width: calc(100vw - 32px);
    height: auto;
    margin: 0;
    translate: -50% 0;
    font: 500 clamp(1rem, 4.5vw, 1.25rem) / normal 'Excon', system-ui, sans-serif;
    text-align: center;
    text-wrap: balance;
    color: var(--navy-100, #141c41);
  }

  /* "Start The Music" / "Stop The Music": centred near the bottom of the screen, inside the painted frame, for the whole hero. */
  .hero__audio {
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: calc(clamp(20px, 3vw, 44px) + 5svh - 16px);
    translate: -50% 0;
  }
  /* The white site button, with navy text and a soft shadow (drop-shadow, so it follows the notched pill). */
  .hero__audio :global(.roll.roll--light) {
    --roll-ink: var(--navy-100, #141c41);
    filter: drop-shadow(0 4px 10px rgb(20 28 65 / 0.25));
  }

  /* Painted frame: one strip per edge, rotated copies of the Figma border. */
  .hero__border {
    --edge: clamp(20px, 3vw, 44px);
    inset: 0;
    pointer-events: none;
    background:
      url(/hero/border-top.png) top / auto var(--edge) repeat-x,
      url(/hero/border-bottom.png) bottom / auto var(--edge) repeat-x,
      url(/hero/border-left.png) left / var(--edge) auto repeat-y,
      url(/hero/border-right.png) right / var(--edge) auto repeat-y;
  }

  /* Each section sits on a darkened photo, so its text switches to light colours. */
  .section {
    --text: #fff;
    --muted: rgb(255 255 255 / 0.8);
    --line: rgb(255 255 255 / 0.3);
    color: var(--text);
    background: linear-gradient(rgb(0 0 0 / 0.55), rgb(0 0 0 / 0.55)), var(--photo, none) center / cover #222;
  }

  /* A chapter's own full-screen scene: the subject sits right of centre, so the copy keeps to the left over a darker side. */
  .section--stage {
    background: linear-gradient(90deg, rgb(0 0 0 / 0.8), rgb(0 0 0 / 0.55) 35%, rgb(0 0 0 / 0) 65%), var(--photo) 70% center / cover #222;
  }
  /* Landscape screens: the painting is sized and shifted so Jon sits in the middle of the right half (75% across).
     He's 64% across the painting, so it needs to be at least 118% of the screen width to reach that point without
     its left edge coming into view. */
  @media (min-aspect-ratio: 1/1) {
    .section--stage {
      --w: max(118vw, 177.78svh);
      background-size: auto, var(--w) auto;
      background-position: 0 0, calc(75vw - 0.64 * var(--w)) center;
    }
  }
  /* Night look (Figma frame 152:212): the painting sits at the top and fades into navy at its bottom edge, with a
     light shade on the left behind the copy. The copy starts near the top rather than in the middle. */
  .section.section--night {
    --navy: #070a18;
    justify-content: flex-start;
    padding-top: clamp(5rem, 9.4vw, 9rem);
    border-bottom: 0;
    background:
      linear-gradient(rgb(7 10 24 / 0) 45%, var(--navy)),
      linear-gradient(90deg, rgb(0 0 0 / 0.4) 4%, rgb(0 0 0 / 0) 69%),
      var(--photo) 70% top / cover no-repeat var(--navy);
  }
  /* Landscape: the painting 116% of the screen wide (as in the frame), Jon three quarters across, its top slightly
     cropped. The section is at least as tall as the painting so the fade finishes in navy, with no seam. */
  @media (min-aspect-ratio: 1/1) {
    .section.section--night {
      --w: max(116vw, 160svh);
      --h: calc(var(--w) * 0.725);
      min-height: max(100svh, calc(var(--h) * 0.94));
      background-size: var(--w) var(--h);
      background-position: min(0px, calc(75vw - 0.65 * var(--w))) calc(var(--h) * -0.06);
    }
  }
  .section--stage.section--night .wrap { margin-inline: clamp(1rem, 7.4vw, 7rem) auto; }

  /* width: auto so the left margin narrows the column instead of pushing it past the right edge. */
  .section--stage .wrap { width: auto; box-sizing: content-box; max-width: 34.25rem; margin-inline: clamp(1rem, 6vw, 6rem) auto; }
  /* The piano panel (Figma frame 10473:235): the painting edge to edge on the dark page, 80px above and below. */
  .section.section--keys { min-height: 0; padding: 0 0 80px; border-bottom: 0; background: #070a18; }

  .section { padding-block: 3rem; border-bottom: 1px solid var(--line); }
</style>
