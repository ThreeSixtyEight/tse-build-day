---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getJournal, formatDate } from '../../lib/content';

const posts = await getJournal();
---

<BaseLayout title="Journal" description="Notes on process, craft and studio life from the Three Sixty Eight team.">
  <section class="wrap intro">
    <p class="label">Notes from the studio</p>
    <h1 class="display">Jour<span class="serif">nal</span></h1>
  </section>
  <section class="wrap">
    {
      posts.length ? (
        <ol class="list">
          {posts.map(({ post, author }) => (
            <li class="reveal">
              <a href={`/journal/${post.id}`}>
                <span class="label date">{formatDate(post.data.date)}</span>
                <span class="title">{post.data.title}</span>
                <span class="excerpt">{post.data.excerpt}</span>
                <span class="label by">By {author?.data.name}</span>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty">Nothing here yet — add a Markdown file to <code>src/content/journal</code>.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .intro { padding-block: clamp(3rem, 8vw, 6rem) clamp(2rem, 5vw, 4rem); }
  .intro .label { color: var(--ink-soft); margin: 0 0 1rem; }
  h1 { font-size: clamp(4rem, 15vw, 13rem); }
  h1 .serif { color: var(--signal); font-weight: 400; }
  .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .list a {
    display: grid; grid-template-columns: 9rem minmax(0, 1.4fr) minmax(0, 1fr) 10rem; gap: 1.5rem; align-items: baseline;
    padding-block: 2rem; border-bottom: 1px solid var(--line); text-decoration: none; transition: padding 0.4s var(--ease);
  }
  .list a:hover { padding-left: 1rem; }
  .list a:hover .title { color: var(--signal); }
  .date, .by { color: var(--ink-soft); }
  .by { text-align: right; }
  .title { font-size: clamp(1.5rem, 3vw, 2.4rem); font-weight: 600; letter-spacing: -0.04em; line-height: 1.05; transition: color 0.3s; }
  .excerpt { color: var(--ink-soft); }
  .empty { border: 1px dashed var(--ink); padding: 3rem; text-align: center; }
  @media (max-width: 860px) {
    .list a { grid-template-columns: 1fr; gap: 0.5rem; }
    .by { text-align: left; }
  }
</style>
