---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Notes from '../components/Notes.astro';

const credits = await getCollection('credits');
const quotes = await getCollection('quotes');
---

<BaseLayout title="Credits" description="Sources and credits for every photo, clip, embed and quote on the site.">
  <section class="wrap page">
    <h1>Credits</h1>
    <p>An unofficial fan site. Not affiliated with or endorsed by Jon Batiste.</p>
    <Notes
      items={[
        'Licensed photos only, credited.',
        'Club names, regalia, footage and music need permission or a credited source.',
      ]}
    />

    <h2>Media</h2>
    {
      credits.length ? (
        <ul>
          {credits.map(({ data }) => (
            <li>
              {data.item} ({data.type}): {data.url ? <a href={data.url}>{data.credit}</a> : data.credit}
            </li>
          ))}
        </ul>
      ) : (
        <p>Credits to come.</p>
      )
    }

    <h2>Quotes</h2>
    {
      quotes.length ? (
        <ul>
          {quotes.map(({ data }) => (
            <li>{data.url ? <a href={data.url}>{data.source}</a> : data.source}, {data.date}</li>
          ))}
        </ul>
      ) : (
        <p>Quote sources to come.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .page { padding-block: 4rem; }
  .page h2 { margin-top: 2.5rem; }
</style>
